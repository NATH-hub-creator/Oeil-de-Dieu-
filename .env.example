# Oeil de Dieu v1.0 - Variables d'environnement
# NAG NAT Industries - 2026
# IMPORTANT : Copier ce fichier en .env et renseigner les valeurs reelles.
# Ne jamais committer le fichier .env dans le depot.

# --- SECURITE ---
# Hash bcrypt du mot de passe maitre (NE JAMAIS mettre le mot de passe en clair)
# Generer avec : python -c "import bcrypt; print(bcrypt.hashpw(b'votre_mdp', bcrypt.gensalt()).decode())"
MASTER_PASSWORD_HASH=$2b$12$XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Cle secrete TOTP pour le Gold Code (generer avec pyotp.random_base32())
GOLD_CODE_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Niveau d'habilitation minimum requis (ne pas modifier sauf autorisation du Comite Ethique)
HABILITATION_MIN=3

# --- BASE DE DONNEES ---
# Chemin vers la base de donnees SQLite
DATABASE_URL=sqlite:///database/oeil_de_dieu.db

# --- SESSIONS ---
# Cle de chiffrement pour les logs de session JSON (32 caracteres)
SESSION_ENCRYPTION_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- APPLICATION ---
# Mode debug (True/False) - Desactiver en production
DEBUG=False

# Duree de vie du Gold Code en secondes (defaut : 300 = 5 minutes)
GOLD_CODE_INTERVAL=300
